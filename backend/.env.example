# ---- Server ----
PORT=4000
# NODE_ENV=production

# ---- Database (db-prd §9) ----
# sqlite = zero-setup dev (backend/mira.db, auto-created + seeded)
# mysql  = production target (MySQL 8, see docker-compose.yml)
DB_DRIVER=sqlite

