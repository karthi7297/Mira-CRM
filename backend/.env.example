# ---- Server ----
PORT=4000
# NODE_ENV=production

# ---- Database (db-prd §9) ----
# sqlite = zero-setup dev (backend/edunexus.db, auto-created + seeded)
# mysql  = production target (MySQL 8, see docker-compose.yml)
DB_DRIVER=sqlite

# SQLite (dev)
# DB_FILE=./edunexus.db

# MySQL (prod)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=edunexus
# MYSQL_PASSWORD=edunexus
# MYSQL_DATABASE=edunexus

# ---- Finance ----
# DEFAULT_TAX_RATE=18
