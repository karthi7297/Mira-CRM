# ---- Server ----
PORT=4000
# NODE_ENV=production

# ---- Database (db-prd §9) ----
# sqlite = zero-setup dev (backend/mira.db, auto-created + seeded)
# mysql  = production target (MySQL 8, see docker-compose.yml)
DB_DRIVER=sqlite

# SQLite (dev)
# DB_FILE=./mira.db

# MySQL (prod)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=mira
# MYSQL_PASSWORD=mira
# MYSQL_DATABASE=mira

# ---- Finance ----
# DEFAULT_TAX_RATE=18

# ---- Email (Nodemailer / Gmail SMTP) ----
# Sends the automatic trainer/student credentials emails on account creation.
# Use a Gmail APP PASSWORD (https://myaccount.google.com/apppasswords).
# Leave empty to disable outbound email — account creation still succeeds and
# the API reports emailSent:false so an admin can use "Resend Credentials".
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Link printed in the emails — must point at the frontend login page.
APPLICATION_LOGIN_URL=http://localhost:5173/login
# Brand name used in the email subject/body.
APP_NAME=Mira
# smtp = real Gmail delivery (default) · json = test transport, no network (CI/dev)
# EMAIL_TRANSPORT=smtp
