[TEMPLATE]
# ---- Server ----
PORT=4000
# NODE_ENV=production

# ---- Security ----
# Comma-separated list of allowed browser origins for CORS. Leave unset in dev
# (same-origin through the Vite proxy). REQUIRED set in production, e.g.:
# CORS_ORIGIN=https://app.mira.example,https://mira.example

# ---- Database (db-prd §9) ----
# sqlite = zero-setup dev (backend/mira.db, auto-created + seeded)
# mysql  = production target (MySQL 8, see docker-compose.yml)
DB_DRIVER=sqlite

# SQLite (dev)
# DB_FILE=./mira.db

# MySQL (prod)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=mira
# MYSQL_PASSWORD=mira
# MYSQL_DATABASE=mira

# ---- Finance ----
# DEFAULT_TAX_RATE=18

# ---- Mira AI assistant (OpenRouter) ----
# Copy this file to backend/.env and paste your own key. Never commit the real
# key — backend/.env is gitignored, this example file is not.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_FALLBACK=inclusionai/ling-3.0-flash-sante:free
# OPENROUTER_MAX_TOKENS=900
# OPENROUTER_TIMEOUT_MS=45000

# ---- Credentials emails (Nodemailer / Gmail SMTP) ----
# Sends the automatic trainer/student credentials emails on account creation.
# Use a Gmail APP PASSWORD (https://myaccount.google.com/apppasswords).
# Leave empty to disable outbound email — account creation still succeeds and
# the API reports emailSent:false so an admin can use "Resend Credentials".
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Link printed in the emails — must point at the frontend login page.
APPLICATION_LOGIN_URL=http://localhost:5173/login
# Brand name used in the email subject/body (shared with SMTP_FROM_NAME).
APP_NAME=Mira
# smtp = real Gmail delivery (default) · json = test transport, no network (CI/dev)
# EMAIL_TRANSPORT=smtp

# ---- Cold mail / outreach (organization role) ----
# Gmail needs an *App Password*, not your normal password:
#   Google Account → Security → 2-Step Verification → App passwords
# Generate one for "Mail", then paste the 16 characters (spaces are fine).
# With SMTP_USER/SMTP_PASS blank the whole outreach system still runs end to
# end — it queues and schedules, and the UI says "not connected" rather than
# pretending anything was sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM_NAME=Rampex
# SMTP_REPLY_TO=you@gmail.com

# Safety rails. Gmail locks free accounts well below its documented limit, so
# keep these conservative — raising them is how a mailbox gets suspended.
# OUTREACH_DAILY_CAP=120          # hard ceiling per day across all campaigns
# OUTREACH_MIN_GAP_MS=20000       # minimum spacing between two sends
# OUTREACH_TICK_MS=60000          # how often the scheduler drains the queue
# OUTREACH_MAX_ATTEMPTS=3         # retries before a recipient is marked FAILED
# PUBLIC_BASE_URL=http://localhost:5173   # origin used to build unsubscribe + open links
